 }
@@ -499,20 +522,32 @@ error:
 int MSWasapi::createAudioClient() {
 	if (mAudioClient != NULL) return -1;
 	bool cleanCo = false;
+	/* NMPBX: diagnostic timing, see nm-pbx-docs/sdk-patches. This function, not activate(), is
