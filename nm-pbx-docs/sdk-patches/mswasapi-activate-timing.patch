 	}
 #endif
@@ -559,9 +607,13 @@ int MSWasapi::createAudioClient() {
 	    result);
 #endif
 	if(cleanCo)	CoUninitialize();
+	ms_message("mswasapi: createAudioClient for %s took %i ms.", mMediaDirectionStr.c_str(),
+	           (int)(ms_get_cur_time_ms() - tClientStart));
 	return 0;
 error:
 	if(cleanCo)	CoUninitialize();
+	ms_message("mswasapi: createAudioClient for %s failed after %i ms.", mMediaDirectionStr.c_str(),
