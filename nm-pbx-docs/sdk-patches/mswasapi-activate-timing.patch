 	}
 	if(result != S_OK){
 		REPORT_ERROR(
@@ -315,10 +333,15 @@ int MSWasapi::activate(bool isCapture, void **audioClient) {
 	           mMediaDirectionStr.c_str(), mDeviceName.c_str(), (int)mTargetRate, (int)mTargetNChannels,
